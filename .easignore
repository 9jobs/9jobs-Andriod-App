# Ignore everything at the root by default
*

# Allow the mobile subdirectory
!mobile/

# Exclude unnecessary files inside mobile
mobile/node_modules/
mobile/android/
mobile/ios/
mobile/artifacts/
mobile/web-dist/
mobile/android-captures/
mobile/android-captures-reloaded/
mobile/scratch/
mobile/metro.log
mobile/*.png
mobile/window_dump*.xml
mobile/interview_voice_dump.xml
mobile/.env*.local
mobile/npm-debug.*
mobile/yarn-debug.*
mobile/yarn-error.*
