{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "buildCommand": "npm run build",
  "functions": {
    "api/server.cjs": {
      "includeFiles": "{.next,app,components,data,lib,models,public,utils}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ]
}
