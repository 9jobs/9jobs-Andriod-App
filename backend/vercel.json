{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/localhost-app-updates": false,
      "main": false
    }
  }
}
